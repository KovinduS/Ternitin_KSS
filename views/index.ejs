<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Ternitin - Free Plagiarism & AI Content Detection">
  <title>Ternitin - Plagiarism & AI Content Detector</title>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <!-- Styles -->
  <link rel="stylesheet" href="/css/main.css">

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>
  <!-- Background Animation Canvas -->
  <canvas id="bg-canvas" class="bg-canvas"></canvas>

  <!-- Theme Toggle -->
  <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
    <i data-lucide="sun" class="icon-sun"></i>
    <i data-lucide="moon" class="icon-moon"></i>
  </button>

  <!-- Navigation -->
  <nav class="navbar glass">
    <div class="nav-container">
      <a href="/" class="nav-logo">
        <i data-lucide="shield-check" class="logo-icon"></i>
        <span class="logo-text">Ternitin</span>
      </a>
      <div class="nav-links">
        <a href="#features" class="nav-link">Features</a>
        <a href="#how-it-works" class="nav-link">How It Works</a>
        <a href="/history" class="nav-link btn-secondary">History</a>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <div class="hero-badge glass">
          <i data-lucide="sparkles"></i>
          <span>100% Free • No API Keys Required • Privacy First</span>
        </div>
        <h1 class="hero-title">
          Detect <span class="gradient-text">Plagiarism</span> & <span class="gradient-text">AI Content</span>
        </h1>
        <p class="hero-description">
          Upload your documents (PDF, DOCX, TXT) and get instant analysis
          using advanced statistical detection and web-based similarity checking.
        </p>

        <!-- Upload Zone -->
        <div class="upload-zone glass" id="uploadZone">
          <input type="file" id="fileInput" accept=".pdf,.doc,.docx,.txt" hidden>

          <div class="upload-content" id="uploadContent">
            <i data-lucide="file-text" class="upload-icon"></i>
            <h3>Drop your document here</h3>
            <p>or click to browse</p>
            <div class="upload-formats">
              <span class="format-tag">PDF</span>
              <span class="format-tag">DOCX</span>
              <span class="format-tag">TXT</span>
              <span class="format-tag">Max 10MB</span>
            </div>
          </div>

          <div class="upload-preview glass" id="uploadPreview" hidden>
            <div class="preview-file">
              <i data-lucide="file-text" class="preview-icon"></i>
              <div class="preview-info">
                <span class="preview-name" id="previewName"></span>
                <span class="preview-size" id="previewSize"></span>
              </div>
            </div>
            <button class="btn btn-danger" id="removeFile">
              <i data-lucide="x"></i>
            </button>
          </div>

          <button class="btn btn-primary btn-lg" id="scanBtn" disabled>
            <span class="btn-text">
              <i data-lucide="search" class="btn-icon"></i>
              Start Analysis
            </span>
            <span class="btn-loading" hidden>
              <div class="spinner"></div>
              Analyzing...
            </span>
          </button>
        </div>

        <!-- Trust Indicators -->
        <div class="trust-indicators">
          <div class="trust-item">
            <i data-lucide="lock"></i>
            <span>Files deleted after scan</span>
          </div>
          <div class="trust-item">
            <i data-lucide="eye-off"></i>
            <span>No data stored permanently</span>
          </div>
          <div class="trust-item">
            <i data-lucide="zap"></i>
            <span>Results in seconds</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual -->
      <div class="hero-visual">
        <div class="floating-cards">
          <div class="float-card glass" style="--i: 0">
            <i data-lucide="search-check"></i>
            <span>Plagiarism Check</span>
          </div>
          <div class="float-card glass" style="--i: 1">
            <i data-lucide="cpu"></i>
            <span>AI Detection</span>
          </div>
          <div class="float-card glass" style="--i: 2">
            <i data-lucide="bar-chart-2"></i>
            <span>Detailed Reports</span>
          </div>
          <div class="float-card glass" style="--i: 3">
            <i data-lucide="history"></i>
            <span>Scan History</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="features">
      <div class="container">
        <header class="section-header">
          <h2>Why Choose Ternitin?</h2>
          <p>Powerful detection without the price tag</p>
        </header>

        <div class="features-grid">
          <article class="feature-card glass">
            <div class="feature-icon">
              <i data-lucide="shield-check"></i>
            </div>
            <h3>Plagiarism Detection</h3>
            <p>Web-based similarity checking using DuckDuckGo and Google Custom Search. Finds matching content across billions of web pages.</p>
            <ul class="feature-list">
              <li><i data-lucide="check"></i> Real-time web search</li>
              <li><i data-lucide="check"></i> Source attribution</li>
              <li><i data-lucide="check"></i> Similarity percentages</li>
            </ul>
          </article>

          <article class="feature-card glass">
            <div class="feature-icon">
              <i data-lucide="cpu"></i>
            </div>
            <h3>AI Content Detection</h3>
            <p>Statistical analysis using perplexity, burstiness, repetition patterns, and transition word frequency. No external API needed.</p>
            <ul class="feature-list">
              <li><i data-lucide="check"></i> Perplexity analysis</li>
              <li><i data-lucide="check"></i> Burstiness scoring</li>
              <li><i data-lucide="check"></i> N-gram diversity</li>
            </ul>
          </article>

          <article class="feature-card glass">
            <div class="feature-icon">
              <i data-lucide="file-text"></i>
            </div>
            <h3>Multi-Format Support</h3>
            <p>Upload PDF, DOCX, DOC, or TXT files. Automatic text extraction with high accuracy.</p>
            <ul class="feature-list">
              <li><i data-lucide="check"></i> PDF parsing</li>
              <li><i data-lucide="check"></i> Word documents</li>
              <li><i data-lucide="check"></i> Plain text</li>
            </ul>
          </article>

          <article class="feature-card glass">
            <div class="feature-icon">
              <i data-lucide="lock"></i>
            </div>
            <h3>Privacy First</h3>
            <p>Your documents are processed temporarily and deleted immediately after analysis. No permanent storage.</p>
            <ul class="feature-list">
              <li><i data-lucide="check"></i> Auto-delete after scan</li>
              <li><i data-lucide="check"></i> No account required</li>
              <li><i data-lucide="check"></i> Local processing</li>
            </ul>
          </article>

          <article class="feature-card glass">
            <div class="feature-icon">
              <i data-lucide="bar-chart-2"></i>
            </div>
            <h3>Detailed Reports</h3>
            <p>Get comprehensive reports with similarity matches, AI indicators, and overall risk assessment.</p>
            <ul class="feature-list">
              <li><i data-lucide="check"></i> Match sources & URLs</li>
              <li><i data-lucide="check"></i> Confidence scores</li>
              <li><i data-lucide="check"></i> Risk verdict</li>
            </ul>
          </article>

          <article class="feature-card glass">
            <div class="feature-icon">
              <i data-lucide="history"></i>
            </div>
            <h3>Scan History</h3>
            <p>Track all your previous scans with statistics and trends. Export or delete anytime.</p>
            <ul class="feature-list">
              <li><i data-lucide="check"></i> Paginated history</li>
              <li><i data-lucide="check"></i> Statistics dashboard</li>
              <li><i data-lucide="check"></i> One-click delete</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- How It Works Section -->
    <section id="how-it-works" class="how-it-works">
      <div class="container">
        <header class="section-header">
          <h2>How It Works</h2>
          <p>Simple 3-step process</p>
        </header>

        <div class="steps">
          <div class="step glass">
            <div class="step-number">01</div>
            <div class="step-icon">
              <i data-lucide="upload"></i>
            </div>
            <h3>Upload Document</h3>
            <p>Drag and drop your PDF, DOCX, or TXT file. Maximum 10MB size.</p>
          </div>

          <div class="step-connector">
            <i data-lucide="chevron-right"></i>
          </div>

          <div class="step glass">
            <div class="step-number">02</div>
            <div class="step-icon">
              <i data-lucide="cpu"></i>
            </div>
            <h3>AI Analysis</h3>
            <p>Our engine extracts text and runs plagiarism + AI detection algorithms in parallel.</p>
          </div>

          <div class="step-connector">
            <i data-lucide="chevron-right"></i>
          </div>

          <div class="step glass">
            <div class="step-number">03</div>
            <div class="step-icon">
              <i data-lucide="file-output"></i>
            </div>
            <h3>Get Results</h3>
            <p>View detailed report with similarity matches, AI probability, and risk assessment.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Results Modal -->
    <div class="modal" id="resultsModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <div class="modal-overlay"></div>
      <div class="modal-content glass">
        <div class="modal-header">
          <h2 id="modalTitle">Analysis Complete</h2>
          <button class="modal-close" id="closeModal" aria-label="Close">
            <i data-lucide="x"></i>
          </button>
        </div>
        <div class="modal-body" id="modalBody">
          <!-- Results injected here -->
        </div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="footer glass">
    <div class="container">
      <div class="footer-content">
        <div class="footer-brand">
          <i data-lucide="shield-check"></i>
          <span>Ternitin</span>
        </div>
        <p>Free plagiarism & AI content detection for everyone</p>
        <div class="footer-links">
          <a href="#">Privacy</a>
          <a href="#">Terms</a>
          <a href="#">GitHub</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Scripts -->
  <script src="/js/main.js"></script>
  <script>lucide.createIcons();</script>
</body>
</html>